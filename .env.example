# Copy to .env for local development. Do not commit real credentials.
APP_ENV=development
LOG_LEVEL=INFO

# Public service addresses (use service DNS names when running in Docker).
CENTRAL_HOST=0.0.0.0
CENTRAL_PORT=8000
FOG_HOST=0.0.0.0
FOG_PORT=8001
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_EDGE_TOPIC=surveillance/edge/events.v1
MQTT_FOG_ALERT_TOPIC=surveillance/fog/alerts.v1

# Persistence & Credentials
# IMPORTANT: In production, generate strong, unique secrets for all variables below.
POSTGRES_USER=cctv_admin
POSTGRES_PASSWORD=replace_with_strong_password
DATABASE_URL=postgresql://cctv_admin:${POSTGRES_PASSWORD}@localhost:5432/cctv_db
REDIS_HOST=localhost
REDIS_PORT=6379
MILVUS_HOST=localhost
MILVUS_PORT=19530
MINIO_ACCESS_KEY=replace_with_minio_access_key
MINIO_SECRET_KEY=replace_with_minio_secret_key

# Security & Authentication
CENTRAL_API_KEY=replace_with_strong_central_api_token
VITE_CENTRAL_API_KEY=replace_with_strong_central_api_token
EVIDENCE_TOKEN=replace_with_strong_evidence_token
MQTT_USERNAME=cctv_user
MQTT_PASSWORD=replace_with_strong_mqtt_password

# Camera and site metadata. Camera-specific configuration belongs in Central,
# not in the dashboard source tree.
CAMERA_ID=cam-main-entrance
RTSP_URL=
LOCAL_VIDEO=
SITE_LAT=28.6139
SITE_LNG=77.2090
SITE_ADDRESS=Primary Home Overwatch Hub

# Model/inference tuning
YOLO_MODEL_PATH=yolov8n.pt
DETECTION_CONFIDENCE=0.45
FACE_MATCH_THRESHOLD=0.62
LOITERING_SECONDS=300
TRACK_EXPIRY_SECONDS=30
SAVE_DEBUG_FRAMES=false

# Development only. Production must configure explicit origins and credentials.
CORS_ORIGINS=http://localhost:3000

# Disabled by default: this enables the quarantined browser-upload AI demo.
VITE_ENABLE_EXPERIMENTAL_BROWSER_AI=false
